// fastfetch: grünes Kairo-K statt Arch-Logo. Eigene Einstellungen gehen in
// ~/.config/fastfetch/config.jsonc und haben Vorrang.
{
  "logo": {
    "type": "file",
    "source": "/usr/local/share/kairo/branding/fastfetch-logo.txt",
    "color": { "1": "38;2;76;195;138" },
    "padding": { "top": 1, "right": 3 }
  },
  "display": { "color": { "keys": "38;2;76;195;138" } },
  "modules": ["title", "separator", "os", "kernel", "uptime", "packages", "shell",
              "de", "cpu", "gpu", "memory", "swap", "disk", "localip", "break", "colors"]
}
