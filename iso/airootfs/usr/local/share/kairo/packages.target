# Pakete, die kairo-install auf die Festplatte installiert (pacstrap).
# Nur offizielle Arch-Repos: core, extra und multilib (32-Bit für Steam).
# Apps, die es nur als Flatpak gibt, stehen in flatpaks.target.

# --- Grundsystem ---------------------------------------------------------------
base
base-devel
# Kernel mit Gaming-/Desktop-Optimierungen (besserer Scheduler, niedrigere
# Latenz). Der eigene linux-kairo kommt erst nach eigenem Boot-Test.
linux-zen
linux-zen-headers
linux-firmware
sof-firmware
sudo
nano
bash-completion
man-db
# Gut lesbare Schrift für die Textkonsole
terminus-font
git
fastfetch
pacman-contrib

# --- AMD: CPU-Microcode, Grafik (Mesa/Vulkan, auch 32-Bit für Steam) -------------
amd-ucode
mesa
lib32-mesa
vulkan-radeon
lib32-vulkan-radeon
vulkan-icd-loader
lib32-vulkan-icd-loader

# --- Desktop: GNOME --------------------------------------------------------------
gnome
gnome-tweaks
gdm
networkmanager
bluez
bluez-utils
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber
xdg-user-dirs
flatpak
power-profiles-daemon
noto-fonts
noto-fonts-emoji
noto-fonts-cjk
ttf-liberation

# --- Optimierung -------------------------------------------------------------------
# Komprimierter Arbeitsspeicher als Swap (statt Swap-Datei)
zram-generator
# Spiele-Modus: CPU-Leistung hoch, solange ein Spiel läuft
gamemode
lib32-gamemode
# FPS-Anzeige in Spielen (MANGOHUD=1 %command% in Steam)
mangohud
lib32-mangohud
gamescope

# --- Apps --------------------------------------------------------------------------
firefox
firefox-i18n-de
steam
discord
# Für die Web-Apps Claude und ChatGPT (eigenes Fenster ohne Browserleiste)
chromium
# Für Claude Code und Codex (KI-Assistenten im Terminal)
nodejs
npm
