#!/usr/bin/env bash
# NUR für den automatischen Installationstest. Gegenstück: scripts/boot-test.py
#
# Erster Start:  Prüfungen ausgeben, dann das Zurückrollen testen:
#                Snapshot anlegen, danach eine Markierungsdatei in /etc,
#                kairo-rollback auf den Snapshot, Neustart.
# Zweiter Start: Ist die Markierung weg, hat das Zurückrollen geklappt.
#
# Der Zwischenstand liegt in /var/log (eigenes Subvolume @var_log), das beim
# Zurückrollen bewusst NICHT zurückgesetzt wird.

stage_file=/var/log/kairo-selftest-stage
marker=/etc/kairo-rollback-marker

# GNOME braucht nach dem Start ein paar Sekunden
for _ in $(seq 60); do
    systemctl is-active --quiet gdm && break
    sleep 2
done
sleep 10

if [[ "$(cat "${stage_file}" 2>/dev/null)" == rollback ]]; then
    {
        echo '===ROLLBACK_BEGIN'
        if [[ -e "${marker}" ]]; then echo "ROLLBACK_MARKER=da"; else echo "ROLLBACK_MARKER=weg"; fi
        echo "GDM=$(systemctl is-active gdm)"
        echo "ROOT=$(findmnt -no SOURCE /)"
        echo '===ROLLBACK_END'
    } > /dev/ttyS0 2>&1
    rm -f "${stage_file}"
    sleep 20
    systemctl poweroff
    exit 0
fi

{
    echo '===SELFTEST_BEGIN'
    cat /etc/os-release
    echo "KERNEL=$(uname -r)"
    echo "GDM=$(systemctl is-active gdm)"
    echo "NM=$(systemctl is-active NetworkManager)"
    echo "FIRSTBOOT_DONE=$(test -e /var/lib/kairo/firstboot-done && echo ja || echo nein)"
    # | cat: sonst schreibt pacman Steuerzeichen für den Cursor auf das Terminal
    pacman -Q --color never steam discord firefox chromium gnome-shell linux-zen amd-ucode \
        vulkan-radeon lib32-vulkan-radeon gamemode mangohud zram-generator \
        snapper snap-pac plymouth openai-codex chatgpt-bin | cat
    echo "CHATGPT=$(command -v chatgpt)"
    if [[ -x /usr/bin/chatgpt && -r /usr/share/applications/chatgpt.desktop ]]; then
        echo "CHATGPT_DESKTOP=ok"
    fi
    pacman-conf --repo-list | grep -qx openai-chatgpt && echo "CHATGPT_REPO=ok"
    # gio = GLib, das gleiche wie GNOME beim Öffnen eines Links
    echo "BROWSER=$(sudo -u tester LC_ALL=C gio mime x-scheme-handler/https | sed -n 's/^Default application.*: //p')"
    echo "FLATPAKS: $(flatpak list --app --columns=application | tr '\n' ' ')"
    echo "CLAUDE=$(command -v claude)"
    echo "CLAUDE_VERSION=$(claude --version 2>&1 | head -1)"
    echo "CODEX=$(command -v codex)"
    echo "CODEX_VERSION=$(codex --version 2>&1 | head -1)"
    echo "SWAP: $(swapon --noheadings --show=NAME | tr '\n' ' ')"
    grep -q '^\[multilib\]' /etc/pacman.conf && echo "MULTILIB=an"
    cat /etc/locale.conf /etc/vconsole.conf /etc/hostname
    echo "GRUPPEN: $(id -nG tester)"
    bootctl status 2>/dev/null | grep -E 'Product:|Firmware:'
    echo "ROOTFS=$(findmnt -no FSTYPE /) $(findmnt -no OPTIONS / | grep -o 'subvol=[^,]*')"
    echo "MOUNTS: $(findmnt -rno TARGET -t btrfs | tr '\n' ' ')"
    echo "CRYPT=$(lsblk -rno TYPE | grep -c '^crypt$')"
    echo "SNAPSHOTS=$(snapper --no-dbus -c root list --columns number | grep -cE '^ *[1-9]')"
    echo "PLYMOUTH=$(sed -n 's/^Theme=//p' /etc/plymouth/plymouthd.conf) $(cat /proc/cmdline)"
    echo "GDM_LOGO=$(DCONF_PROFILE=gdm dconf read /org/gnome/login-screen/logo)"
    echo "UPDATE_TIMER=$(systemctl --global is-enabled kairo-update-check.timer)"
    echo "UPDATE_CHECK=$(sudo -u tester checkupdates >/dev/null 2>&1; echo $?)"
    echo "LOGO: $(find /usr/local/share/kairo/branding/ -maxdepth 1 -type f -printf '%f ')"
    grep -q 'kairo-start --autostart' /etc/xdg/autostart/kairo-start.desktop && echo "AUTOSTART=kairo-start"
    ls -1 /usr/local/share/applications/
    # Ohne Protokoll lässt sich ein fehlgeschlagener erster Start nicht klären
    if [[ ! -e /var/lib/kairo/firstboot-done ]]; then
        echo '===FIRSTBOOT_LOG_BEGIN'
        journalctl -u kairo-firstboot -b --no-pager -o cat | grep -v '^y$' | tail -n 150
        echo '===FIRSTBOOT_LOG_END'
    fi
    echo '===SELFTEST_END'
} > /dev/ttyS0 2>&1

# Zeit für den Screenshot des Anmeldebildschirms
sleep 30

# --- Zurückrollen testen ---------------------------------------------------------
{
    echo '===ROLLBACK_TEST'
    num="$(snapper --no-dbus -c root create -d "Selbsttest vor Rollback" --print-number)"
    echo "SNAPSHOT=${num}"
    echo "Diese Datei muss nach dem Zurückrollen weg sein" > "${marker}"
    echo rollback > "${stage_file}"
    sync
    kairo-rollback --yes "${num}"
    echo "ROLLBACK_EXIT=$?"
} > /dev/ttyS0 2>&1
systemctl reboot
