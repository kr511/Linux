# Lädt beim ersten Start mit Internet die Flatpak-Apps (Roblox/Sober, Spotify,
# VS Code) und Claude Code nach. Klappt etwas nicht, versucht es der Dienst
# beim nächsten Start erneut. Protokoll: journalctl -u kairo-firstboot

[Unit]
Description=Kairo: Apps beim ersten Start nachladen
Wants=network-online.target
After=network-online.target
ConditionPathExists=!/var/lib/kairo/firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kairo-firstboot
TimeoutStartSec=1h

[Install]
WantedBy=multi-user.target
