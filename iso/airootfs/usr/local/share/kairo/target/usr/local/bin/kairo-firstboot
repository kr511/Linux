#!/usr/bin/env bash
#
# Wird einmalig von kairo-firstboot.service ausgeführt (als root).
# Installiert Apps, die es nicht als Arch-Paket gibt. Erst wenn alles
# geklappt hat, wird /var/lib/kairo/firstboot-done angelegt.

set -uo pipefail

failed=0

flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo \
    || failed=1

while read -r app; do
    echo "==> Flatpak: ${app}"
    flatpak install --system --noninteractive --assumeyes flathub "${app}" || failed=1
done < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' /usr/local/share/kairo/flatpaks.target | awk NF)

# KI-Assistenten fürs Terminal: Befehle "claude" und "codex"
for pkg in @anthropic-ai/claude-code @openai/codex; do
    echo "==> npm: ${pkg}"
    npm install --global "${pkg}" || failed=1
done

if (( failed )); then
    echo "Nicht alles hat geklappt, nächster Versuch beim nächsten Start." >&2
    exit 1
fi
mkdir -p /var/lib/kairo
touch /var/lib/kairo/firstboot-done
echo "==> Fertig"
