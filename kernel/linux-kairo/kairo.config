# Kairo-Kernel-Anforderungen (Kconfig-Fragment)
#
# Das ist KEINE vollständige Kernel-Konfiguration. Die Basis ist die offizielle
# Arch-Konfiguration (config.arch-base). Diese Datei legt fest, was für Kairo
# auf jeden Fall gelten MUSS. Beim Build wird sie über die Basis gelegt und
# verify-config.py prüft danach, dass jede Zeile hier wirklich erfüllt ist.
#
#   =y  fest im Kernel     =m  als ladbares Modul (=y ist dann auch ok)
#
# Jede Option wurde gegen den Kconfig-Quellcode von Linux 7.2.12 geprüft.

# --- Kennung ----------------------------------------------------------------------
# uname -r zeigt dann z. B. 7.2.12-1-kairo (Suffix kommt aus localversion-Dateien)
CONFIG_LOCALVERSION=""
# Aktuelle Kernel-Config unter /proc/config.gz abrufbar, hilft beim Debuggen
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# --- Boot (UEFI, Initramfs) ---------------------------------------------------------
CONFIG_EFI=y
# Kernel ist selbst eine EFI-Anwendung (nötig für systemd-boot)
CONFIG_EFI_STUB=y
# Zugriff auf UEFI-Variablen (efibootmgr, bootctl)
CONFIG_EFIVAR_FS=y
CONFIG_BLK_DEV_INITRD=y
# Arch-Initramfs ist standardmäßig zstd-komprimiert
CONFIG_RD_ZSTD=y
# Grafik-Ausgabe über die UEFI-Firmware, bevor amdgpu geladen ist
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y

# --- CPU: AMD Ryzen 5 4500 (Zen 2) ------------------------------------------------
CONFIG_CPU_SUP_AMD=y
# Moderne Taktsteuerung für Zen 2+ (braucht CPPC-Unterstützung im BIOS)
CONFIG_X86_AMD_PSTATE=y
# Hardware-Fehlermeldungen (Machine Check) für AMD
CONFIG_X86_MCE_AMD=y
# IOMMU: nötig für saubere Geräte-Isolation und später GPU-Passthrough
CONFIG_AMD_IOMMU=y
# Temperatursensor der Ryzen-CPU (für sensors, btop usw.)
CONFIG_SENSORS_K10TEMP=m

# --- GPU: AMD Radeon RX 6500 XT (RDNA2, "Navi 24") --------------------------------
CONFIG_DRM_AMDGPU=m
# Display Core: Pflicht für Bildausgabe auf allen RDNA-Karten
CONFIG_DRM_AMD_DC=y
# Kernel-Teil für GPU-Compute (ROCm/OpenCL)
CONFIG_HSA_AMD=y
# Hinweis: Die Firmware (beige_goby_*) kommt aus dem Paket linux-firmware,
# nicht aus dem Kernel.

# --- Speicher: NVMe, SATA ----------------------------------------------------------
CONFIG_BLK_DEV_NVME=m
CONFIG_ATA=y
CONFIG_SATA_AHCI=m

# --- USB --------------------------------------------------------------------------
CONFIG_USB_XHCI_HCD=m
CONFIG_USB_XHCI_PCI=m
CONFIG_USB_STORAGE=m
CONFIG_USB_UAS=m
CONFIG_USB_HID=m
CONFIG_HID_GENERIC=m

# --- Dateisysteme -----------------------------------------------------------------
CONFIG_EXT4_FS=m
CONFIG_BTRFS_FS=m
CONFIG_XFS_FS=m
# FAT32: Pflicht für die EFI-Systempartition
CONFIG_VFAT_FS=m
CONFIG_EXFAT_FS=m
# NTFS (Windows-Partitionen lesen), moderner Kernel-Treiber
CONFIG_NTFS3_FS=m
CONFIG_FUSE_FS=m
# Live-ISO: Das Live-System liegt als squashfs (xz) auf einer ISO9660-CD,
# Schreibzugriffe landen per overlayfs im RAM. Ohne diese drei bootet keine ISO.
CONFIG_ISO9660_FS=m
CONFIG_SQUASHFS=m
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=m
CONFIG_BLK_DEV_LOOP=m

# --- Virtualisierung --------------------------------------------------------------
# Kairo als Host: virtuelle Maschinen mit KVM auf AMD-CPUs
CONFIG_KVM=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
# Kairo als Gast (z. B. unsere QEMU-Tests): virtio-Geräte
CONFIG_VIRTIO_PCI=m
CONFIG_VIRTIO_BLK=m
CONFIG_VIRTIO_NET=m
CONFIG_SCSI_VIRTIO=m
CONFIG_DRM_VIRTIO_GPU=m
